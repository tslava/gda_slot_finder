# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID_CITIZENSHIP=-1234567890
TELEGRAM_CHAT_ID_VNZ=-1234567890

# Google Sheets Configuration
GOOGLE_CREDENTIALS_FILE_PATH=/path/to/your/google-credentials.json
GOOGLE_TABLE_ID_CITIZENSHIP=your_google_sheet_id_for_citizenship_data
GOOGLE_TABLE_ID_VNZ=your_google_sheet_id_for_vnz_data

# API URLs - Citizenship service (rezerwacja.gdansk.uw.gov.pl)
CITIZENSHIP_DATES_URL=https://example.com/qmaticwebbooking/rest/schedule/branches/BRANCH_ID/dates;servicePublicId=SERVICE_ID;customSlotLength=40
CITIZENSHIP_TIMES_URL=https://example.com/qmaticwebbooking/rest/schedule/branches/BRANCH_ID/dates/{date}/times;servicePublicId=SERVICE_ID;customSlotLength=40

# API URLs - VNZ service (kolejka.gdansk.uw.gov.pl)
VNZ_DATES_URL_BASE=https://example.com/admin/API/date/BRANCH/SERVICE/{lang}
VNZ_TIMES_URL_BASE=https://example.com/admin/API/time/BRANCH/SERVICE/{date}
